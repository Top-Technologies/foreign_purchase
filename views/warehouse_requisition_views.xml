<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="foreign_purchase_requisition_form" model="ir.ui.view">
        <field name="name">foreign.purchase.requisition.form</field>
        <field name="model">foreign.purchase.requisition</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_mark_proforma" type="object" string="Proforma received" class="oe_highlight" invisible="state != 'submitted'"/>
                    <button name="action_create_import_request" type="object" string="Import Purchase Request" class="oe_highlight" invisible="state not in ('submitted', 'proforma') or approval_request_id"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('ordered', 'cancel')"/>
                    <button name="action_reset_draft" type="object" string="Reset to draft" invisible="state != 'cancel' or approval_request_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,proforma,requested,ordered"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_import_request" type="object" class="oe_stat_button" icon="fa-check-square-o" invisible="not approval_request_id">
                            <span>Purchase request</span>
                        </button>
                        <button name="action_open_purchase_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart" invisible="not purchase_order_ids">
                            <span>Purchase orders</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="requester_id" widget="many2one_avatar_user" readonly="state != 'draft'"/>
                            <field name="request_date" readonly="state != 'draft'"/>
                            <field name="product_id" readonly="state not in ('draft', 'submitted', 'proforma')"/>
                            <field name="quantity" readonly="state not in ('draft', 'submitted', 'proforma')"/>
                            <field name="uom_id" readonly="state not in ('draft', 'submitted', 'proforma')"/>
                        </group>
                        <group>
                            <field name="proforma" filename="proforma_name" readonly="state in ('ordered', 'cancel')"/>
                            <field name="proforma_name" invisible="1"/>
                            <field name="approval_request_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <separator string="Specification"/>
                    <field name="specification" readonly="state not in ('draft', 'submitted', 'proforma')" placeholder="Describe the goods, the standard, and any size or brand the supplier must meet."/>
                    <field name="purchase_order_ids" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="foreign_purchase_requisition_tree" model="ir.ui.view">
        <field name="name">foreign.purchase.requisition.list</field>
        <field name="model">foreign.purchase.requisition</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="request_date"/>
                <field name="requester_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="foreign_purchase_requisition_search" model="ir.ui.view">
        <field name="name">foreign.purchase.requisition.search</field>
        <field name="model">foreign.purchase.requisition</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="product_id"/>
                <filter name="open" string="Open" domain="[('state', 'not in', ('ordered', 'cancel'))]"/>
                <filter name="mine" string="My requests" domain="[('requester_id', '=', uid)]"/>
            </search>
        </field>
    </record>

    <record id="action_warehouse_requisitions" model="ir.actions.act_window">
        <field name="name">Warehouse Requisitions</field>
        <field name="res_model">foreign.purchase.requisition</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="foreign_purchase_requisition_search"/>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ask for goods that must be imported</p>
            <p>Write the specification, attach the supplier proforma, then raise the Import Purchase Request.</p>
        </field>
    </record>

</odoo>
