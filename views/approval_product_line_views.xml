<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_product_line_vendor_domain" model="ir.ui.view">
        <field name="name">approval.product.line.vendor.domain</field>
        <field name="model">approval.product.line</field>
        <field name="inherit_id" ref="approvals_purchase.approval_purchase_product_line_view_tree_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='seller_id']" position="before">
                <field name="product_template_id" column_invisible="1"/>
                <field name="has_no_seller" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='seller_id']" position="attributes">
                <attribute name="domain">[] if not product_template_id or has_no_seller else [('product_tmpl_id', '=', product_template_id)]</attribute>
                <attribute name="column_invisible">parent.approval_type != 'purchase' or parent.is_import_purchase</attribute>
            </xpath>
            <xpath expr="//field[@name='seller_id']" position="after">
                <field name="import_vendor_id" column_invisible="not parent.is_import_purchase"/>
                <field name="import_price_unit" column_invisible="not parent.is_import_purchase"/>
            </xpath>
        </field>
    </record>

    <record id="approval_request_import_price" model="ir.ui.view">
        <field name="name">approval.request.import.price</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="approvals.approval_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_line_ids']" position="before">
                <field name="is_import_purchase" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
