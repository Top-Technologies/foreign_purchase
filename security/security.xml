<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_foreign_purchase">
        <field name="name">Foreign Purchase</field>
        <field name="sequence">15</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_foreign_officer" model="res.groups">
        <field name="name">Import Officer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_foreign_purchase"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        <field name="comment">Fills letter of credit details, shipment documents, and the utilization letter.</field>
    </record>

    <record id="group_foreign_finance" model="res.groups">
        <field name="name">Import Finance</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_foreign_purchase"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user')), (4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Records the letter of credit deposit, supplier and charge bills, and the landed cost.</field>
    </record>

    <record id="group_foreign_dm" model="res.groups">
        <field name="name">Department Manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_foreign_purchase"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        <field name="comment">Approves import orders up to the Department Manager amount.</field>
    </record>

    <record id="group_foreign_dgm" model="res.groups">
        <field name="name">Deputy General Manager</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_foreign_purchase"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        <field name="comment">Approves import orders above the Department Manager amount.</field>
    </record>

    <record id="group_foreign_gm" model="res.groups">
        <field name="name">General Manager</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="res_groups_privilege_foreign_purchase"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        <field name="comment">Approves import orders above the Deputy General Manager amount.</field>
    </record>

    <record id="foreign_purchase_requisition_company_rule" model="ir.rule">
        <field name="name">Warehouse requisition multi-company</field>
        <field name="model_id" ref="model_foreign_purchase_requisition"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="foreign_purchase_requisition_own_rule" model="ir.rule">
        <field name="name">Warehouse requisition: own requests</field>
        <field name="model_id" ref="model_foreign_purchase_requisition"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('requester_id', '=', user.id)]</field>
    </record>
    <record id="foreign_purchase_requisition_purchase_rule" model="ir.rule">
        <field name="name">Warehouse requisition: purchase users</field>
        <field name="model_id" ref="model_foreign_purchase_requisition"/>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="foreign_purchase_requisition_stock_rule" model="ir.rule">
        <field name="name">Warehouse requisition: inventory users</field>
        <field name="model_id" ref="model_foreign_purchase_requisition"/>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="foreign_purchase_comparison_company_rule" model="ir.rule">
        <field name="name">Supplier comparison multi-company</field>
        <field name="model_id" ref="model_foreign_purchase_comparison"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="foreign_purchase_claim_company_rule" model="ir.rule">
        <field name="name">Import claim multi-company</field>
        <field name="model_id" ref="model_foreign_purchase_claim"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
