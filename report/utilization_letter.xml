<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_utilization_letter" model="ir.actions.report">
        <field name="name">Utilization Letter</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">foreign_purchase.report_utilization_letter</field>
        <field name="report_file">foreign_purchase.report_utilization_letter</field>
        <field name="print_report_name">'Utilization - %s' % (object.lc_number or object.name)</field>
    </record>

    <template id="report_utilization_letter">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="order">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Utilization Letter</h2>
                        <p>
                            Please use letter of credit
                            <strong t-field="order.lc_number"/>
                            for purchase order
                            <strong t-field="order.name"/>.
                        </p>
                        <table class="table table-sm">
                            <tr>
                                <td>Supplier</td>
                                <td><span t-field="order.partner_id"/></td>
                            </tr>
                            <tr>
                                <td>Amount</td>
                                <td><span t-field="order.amount_total"/></td>
                            </tr>
                            <tr>
                                <td>Deposit</td>
                                <td>
                                    <span t-field="order.lc_deposit_amount"/>
                                    (<span t-field="order.lc_deposit_percent"/>%)
                                </td>
                            </tr>
                            <tr>
                                <td>Still to pay</td>
                                <td><span t-field="order.balance_foreign_amount"/></td>
                            </tr>
                            <tr>
                                <td>Opening date</td>
                                <td><span t-field="order.lc_opening_date"/></td>
                            </tr>
                            <tr>
                                <td>Latest shipment date</td>
                                <td><span t-field="order.lc_latest_shipment_date"/></td>
                            </tr>
                            <tr>
                                <td>Expiry date</td>
                                <td><span t-field="order.lc_expiry_date"/></td>
                            </tr>
                            <tr>
                                <td>Incoterm</td>
                                <td><span t-field="order.incoterm_id"/></td>
                            </tr>
                        </table>
                        <p>The goods on this order are:</p>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Unit price</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="order.order_line" t-as="line">
                                    <tr t-if="not line.display_type">
                                        <td><span t-field="line.name"/></td>
                                        <td class="text-end"><span t-field="line.product_qty"/></td>
                                        <td class="text-end"><span t-field="line.price_unit"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
